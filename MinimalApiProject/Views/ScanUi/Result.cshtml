@model MinimalApiProject.Models.ScanResultModel

@{
    ViewData["Title"] = "Scan Result";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="@Url.Content("~/css/site.css")" />

<div class="result-box">
    <h3 style="color:#0a192f; font-weight:600; font-size:1.15em;">Scan Results</h3>
    @if (Model.Success)
    {
        <div>
            @if (Model.Results != null && Model.Results.Count > 0)
            {
                <button id="exportExcelBtn" class="btn btn-success mb-3">Export to Excel</button>
                foreach (var r in Model.Results)
                {
                    <div class="result-paragraph">
                        <span style="color:#0a192f;font-weight:500;">File:</span>
                        <span>@r.FilePath</span> <br />
                        <span style="color:#0a192f;">Class:</span> @r.ClassName &nbsp;
                        <span style="color:#0a192f;">Method:</span> @r.MethodName &nbsp;
                        <span style="color:#0a192f;">Line:</span> @r.LineNumber <br />
                        <span style="color:#0a192f;">Issue:</span>
                        <span style="font-weight:600; color:@(r.IssueType.Contains("No authorization") ? "#dc3545" : r.IssueType.Contains("present but lacks") ? "#ffc107" : "#28a745");">
                        <span class="@(r.IssueType.Contains("No authorization") ? "issue-red" : r.IssueType.Contains("present but lacks") ? "issue-yellow" : "issue-green")">
                            @r.IssueType
                        </span>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-success mt-4">No issues found!</div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-danger mt-4">@Model.ErrorMessage</div>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const exportBtn = document.getElementById('exportExcelBtn');
            if (exportBtn) {
                exportBtn.addEventListener('click', function () {
                    
                    const results = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Results));
                    
                    fetch('/ScanUi/ExportToExcel', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(results) 
                    })
                        .then(response => {
                            if (!response.ok) throw new Error('Excel export failed');
                            return response.blob();
                        })
                        .then(blob => {
                            const url = window.URL.createObjectURL(blob);
                            const a = document.createElement('a');
                            a.href = url;
                            a.download = "ScanResults.xlsx";
                            document.body.appendChild(a);
                            a.click();
                            window.URL.revokeObjectURL(url);
                        });
                });
            }
        });
    </script>
}
