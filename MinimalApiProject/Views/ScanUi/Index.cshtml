@model MinimalApiProject.Models.ScanFormModel

@{
    ViewData["Title"] = "Authorization Annotation Checker";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

<div class="container bg-white rounded-3 shadow p-5" style="max-width:600px; margin-top:50px;">
    <h2 class="mb-4" style="color:#0a192f;">Authorization Annotation Checker</h2>
    
    @* Hata mesajı göstergesi *@
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }
    
    <form asp-action="Scan" method="post" autocomplete="off" enctype="multipart/form-data">

        <div class="form-check mb-3">
            <input class="form-check-input" type="radio" name="Mode" id="remoteRadio" value="Remote" checked>
            <label class="form-check-label" for="remoteRadio">Remote Repository</label>
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" type="radio" name="Mode" id="localRadio" value="Local">
            <label class="form-check-label" for="localRadio">Upload from Local</label>
        </div>

        <div id="remoteFields">
            <div class="mb-2">
                <label class="form-label">Organization</label>
                <input class="form-control" name="Organization" placeholder="Organization" required />
            </div>
            <div class="mb-2">
                <label class="form-label">Project</label>
                <input class="form-control" name="Project" placeholder="Project" required />
            </div>
            <div class="mb-2">
                <label class="form-label">Repository</label>
                <input class="form-control" name="Repository" placeholder="Repository" required />
            </div>
            <div class="mb-2">
                <label class="form-label">Personal Access Token</label>
                <input class="form-control" name="PersonalAccessToken" placeholder="Personal Access Token" />
            </div>
        </div>
        <div id="localFields" style="display:none;">
         
            <input class="form-control" type="file" id="localFiles" name="localFiles" webkitdirectory directory multiple />
            <div class="form-text">
                Select the root folder of your local repository. All .cs files (including subfolders) will be scanned.
            </div>
        </div>

        <button type="submit" class="btn btn-primary mt-4 w-100">Scan</button>
    </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const remoteRadio = document.getElementById('remoteRadio');
    const localRadio = document.getElementById('localRadio');
    const remoteFields = document.getElementById('remoteFields');
    const localFields = document.getElementById('localFields');

    function toggleFields() {
        if (remoteRadio.checked) {
            remoteFields.style.display = '';
            localFields.style.display = 'none';
            remoteFields.querySelectorAll("input").forEach(inp => inp.required = true);
            localFields.querySelectorAll("input").forEach(inp => inp.required = false);
        } else {
            remoteFields.style.display = 'none';
            localFields.style.display = '';
            remoteFields.querySelectorAll("input").forEach(inp => inp.required = false);
            localFields.querySelectorAll("input").forEach(inp => inp.required = true);
        }
    }

    remoteRadio.addEventListener('change', toggleFields);
    localRadio.addEventListener('change', toggleFields);
    toggleFields();
});
</script>
