@model MinimalApiProject.Models.ScanFormModel

@{
    ViewData["Title"] = "Authorization Checker";
}

<!-- Bootstrap CDN (varsa kaldırabilirsin, VS projelerinde genelde hazır gelir) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

<div class="container bg-white rounded-3 shadow p-5" style="max-width:600px; margin-top:50px;">
    <h2 class="mb-4" style="color:#0a192f;">Authorization Checker</h2>
    <form asp-action="Scan" method="post">
        <div class="form-check mb-3">
            <input class="form-check-input" type="radio" name="Mode" id="remoteRadio" value="Remote" checked>
            <label class="form-check-label" for="remoteRadio">Remote Repo</label>
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" type="radio" name="Mode" id="localRadio" value="Local">
            <label class="form-check-label" for="localRadio">Upload from Local</label>
        </div>

        <div id="remoteFields">
            <div class="mb-2">
                <input class="form-control" name="Organization" placeholder="Organization" />
            </div>
            <div class="mb-2">
                <input class="form-control" name="Project" placeholder="Project" />
            </div>
            <div class="mb-2">
                <input class="form-control" name="Repository" placeholder="Repository" />
            </div>
            <div class="mb-2">
                <input class="form-control" name="PersonalAccessToken" placeholder="Personal Access Token" />
            </div>
        </div>
        <div id="localFields" style="display:none;">
            <input class="form-control" name="LocalPath" placeholder="Local Folder Path" />
        </div>

        <button type="submit" class="btn btn-primary mt-4 w-100">Scan</button>
    </form>
</div>

<!-- Basit JS ile input alanlarını yönetiyoruz -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const remoteRadio = document.getElementById('remoteRadio');
    const localRadio = document.getElementById('localRadio');
    const remoteFields = document.getElementById('remoteFields');
    const localFields = document.getElementById('localFields');

    function toggleFields() {
        if (remoteRadio.checked) {
            remoteFields.style.display = '';
            localFields.style.display = 'none';
        } else {
            remoteFields.style.display = 'none';
            localFields.style.display = '';
        }
    }

    remoteRadio.addEventListener('change', toggleFields);
    localRadio.addEventListener('change', toggleFields);
    toggleFields();
});
</script>
